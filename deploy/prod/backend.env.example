# backend.env for the prod compose — real values NOT in git (secrets/private values left empty).
# Loaded after the project main_app/.env; compose environment (SECRET_KEY, DB_PASSWORD, KAVENEGAR_API_KEY,
# DB_HOST=pgbouncer, DB_PORT=6432) overrides both.
# Deployment overrides on top of the project's main_app/.env (secrets: ./.env).
DJANGO_ENV=prod
DEBUG=false
ENV=production
ALLOWED_HOSTS=194.60.230.57,lottery.bordino.co,localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=http://194.60.230.57:8097,https://lottery.bordino.co
CORS_ALLOWED_ORIGINS=http://194.60.230.57:8097,https://lottery.bordino.co
CORS_ORIGIN_WHITELIST=http://194.60.230.57:8097,https://lottery.bordino.co
APP_DOMAIN=https://lottery.bordino.co
DB_TYPE=postgres
DB_NAME=lottery
DB_USER=lottery
DB_HOST=db
DB_PORT=5432
REDIS_LOCATION=redis://redis:6379/1
DJANGO_SETTINGS_MODULE=main_app.settings
CELERY_SETTINGS_MODULE=confs.celery_config.celery_config
# (line omitted)
# (line omitted)
USE_MINIO=false
TIME_ZONE=Asia/Tehran
TIME_ZONE_CELERY_BEAT=Asia/Tehran
# Empty, not "false": settings.py keeps these as strings and "false" is truthy.
# HTTPS redirect is done by caffemenu's Caddy for the domain; the IP is plain HTTP.
SECURE_SSL_REDIRECT=
SENTRY_DSN=

# SMS: Kavenegar account shared with caffemenu (key in ./.env); its approved OTP template.
KAVENEGAR_OTP_TEMPLATE=OTP
# Admin login by SMS code — only these numbers (comma-separated).
ADMIN_OTP_WHITELIST=

# Web Push («مدیریت اعلان‌ها»), generated 2026-10-28
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@bordino.co
